# baseline/frozen snapshot trees are regenerable; never track.
# Covers the naming side-channel class (tree/, head-tree/, work-tree/, …) —
# xsentinel w7-F1: name-exact patterns missed a 42M head-tree/ in r67.
live/*/tree/
live/*/frozen/
live/*/*tree*/
# xsentinel w8-F4: non-tree snapshot side-channel names (head/, snapshot/,
# base/, *extract*/) — same class as the tree/frozen rules above.
live/*/head/
live/*/snapshot/
live/*/base/
live/*/*extract*/
# xsentinel w9: *tree* dirs at ANY depth (replica/tree/ at depth 3 escaped the
# depth-2 pattern — flagged by r70-baseline read-side check)
live/**/*tree*/
