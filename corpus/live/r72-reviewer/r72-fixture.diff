+                    info)
+            finally:
+                os.close(r)
+        if transport == "redirected_fd":
+            fd = os.open(str(path), os.O_RDONLY)
+            try:
+                info = _SF_INFO()
+                return _sndfile_verdict(
+                    _SNDFILE.sf_open_fd(fd, _SFM_READ, ctypes.byref(info), 0),
+                    info)
+            finally:
