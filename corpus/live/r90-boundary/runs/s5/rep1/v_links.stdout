r89b_ns:playback_FL
  r89b_ns:playback_0
  r89b_ns Audio/Sink sink:playback_FL
  |<- pw-play:output_FL
r89b_ns:playback_FR
  r89b_ns:playback_1
  r89b_ns Audio/Sink sink:playback_FR
  |<- pw-play:output_FR
r98s_ns:playback_MONO
  r98s_ns:playback_0
  r98s_ns Audio/Sink sink:playback_MONO
  |<- r98s_drain:output_MONO
r98s_drain:output_MONO
  r98s_drain:output_0
  r98s_drain:output_MONO
  |-> r98s_ns:playback_MONO
pw-play:output_FL
  pw-play:output_0
  pw-play:output_FL
  |-> r89b_ns:playback_FL
pw-play:output_FR
  pw-play:output_1
  pw-play:output_FR
  |-> r89b_ns:playback_FR
r90b_la:monitor_FL
  r90b_la:monitor_0
  r90b_la Audio/Sink sink:monitor_FL
  |-> r90b_lb:playback_FL
r90b_lb:playback_FL
  r90b_lb:playback_0
  r90b_lb Audio/Sink sink:playback_FL
  |<- r90b_la:monitor_FL
