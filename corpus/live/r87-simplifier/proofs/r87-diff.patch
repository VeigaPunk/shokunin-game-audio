+            T("p_noauto", ["-P", "node.autoconnect=false",
+                           "--target", PWBIND_R87_NS])
+            T("p_mon", ["--target", PWBIND_R87_NS + ".monitor"])
+            T("p_mon_cs", ["-P", "stream.capture.sink=true",
