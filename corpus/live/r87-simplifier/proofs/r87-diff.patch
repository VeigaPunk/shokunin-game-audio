+                    time.sleep(1.3)
+                    g = _pwbind_r87_graph()
+                    dn = (_pwbind_r87_node(
+                        g, PWBIND_R87_PREFIX + "_mdump")
+                        or _pwbind_r87_node(g, "midi-dump"))
+                    arec = {"attempt": attempt,
+                            "node": bool(dn)}
