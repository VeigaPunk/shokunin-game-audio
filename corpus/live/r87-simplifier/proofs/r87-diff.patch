+            T("p_three", ["-P", f"target.object={PWBIND_R87_NS2}",
+                          "-P", f"node.target={PWBIND_R87_NS}",
+                          "--target", PWBIND_R87_NS])
+            T("p_prop_twice", ["-P", f"target.object={PWBIND_R87_NS}",
