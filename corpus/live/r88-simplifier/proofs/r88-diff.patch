+def _btwit_r88_run(argv, timeout_s, env=None, stdin_data=None,
+                   keep_chars=900, keep_raw=False):
+    """One bounded spawn -> rc/signal/stdout/stderr + r88 error class
+    (same kill-group discipline as r87's runner)."""
+    rec = {"argv": " ".join(str(a) for a in argv)}
+    try:
+        proc = subprocess.Popen(
+            argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            stdin=(subprocess.PIPE if stdin_data is not None
+                   else subprocess.DEVNULL),
+            env=env, start_new_session=True)
+    except OSError as exc:
+        rec["spawn_error"] = str(exc)[:160]
+        return rec
+    t0 = time.monotonic()
+    killed = False
+    try:
+        out, err = proc.communicate(input=stdin_data, timeout=timeout_s)
+    except subprocess.TimeoutExpired:
+        killed = True
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        out, err = proc.communicate()
+    errt = err.decode(errors="replace")
+    outt = out.decode(errors="replace")
+    cls, hit = _btwit_r88_errclass(errt + "\n" + outt)
+    rec.update({"exit_code": proc.returncode,
+                "signal": (signal.Signals(-proc.returncode).name
+                           if (proc.returncode or 0) < 0 else None),
+                "killed_at_bound": killed,
+                "wall_s": round(time.monotonic() - t0, 3),
+                "stdout_head": outt.strip().splitlines()[:4],
+                "stdout": _btwit_r88_norm(outt)[:keep_chars],
+                "stdout_bytes": len(outt),
+                "stderr_head": errt.strip().splitlines()[:4],
+                "stderr": _btwit_r88_norm(errt)[:keep_chars],
+                "stderr_bytes": len(errt),
+                "error_class": cls, "error_hit": hit})
+    if keep_raw:
+        # the verbatim channels for in-run parsers — the normed text
+        # above is the recorded witness; ids must survive for the
+        # ls/serial/set parsers (recorded, never armed)
+        rec["stdout_raw"] = outt
+        rec["stderr_raw"] = errt
+    return rec
+
