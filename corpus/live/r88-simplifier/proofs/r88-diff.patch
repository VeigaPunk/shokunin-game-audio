+def _btwit_r88_norm(text):
+    """Volatile-field scrub: r87's node/seq/hex classes plus the
+    `id:<n> seq:<n>` remote-error counters and `object <n>` (the
+    enum-params not-implemented text embeds the live id)."""
+    s = _pwbind_r87_norm(text or "")
+    s = re.sub(r"id:\d+ seq:\d+", "id:<n> seq:<n>", s)
+    s = re.sub(r"object \d+", "object <n>", s)
+    return s
+
