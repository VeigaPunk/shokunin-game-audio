+def _btwit_r88_top_frames(text):
+    """pw-top -b output -> [frame]; each frame is [{status,id}] with
+    the header row excluded."""
+    frames, cur = [], None
+    for ln in (text or "").splitlines():
+        if re.match(r"^S\s+ID\s+QUANT", ln):
+            cur = []
+            frames.append(cur)
+            continue
+        m = re.match(r"^([A-Za-z])\s+(\d+)\s", ln)
+        if cur is not None and m:
+            cur.append({"status": m.group(1), "id": int(m.group(2))})
+    return frames
+
+
+def _btwit_r88_top_until(n_arg, min_frames, bound_s=20.0, tries=3):
+    """`pw-top -b -n <n>` up to `tries` times until ≥`min_frames`
+    parse; returns (rec, frames). The printed frame count is
+    advisory relative to N — the boundary saw `-n 3` emit 4 frames
+    and `-n 2` emit 3 on one host, and a same-host dev run emit 1 —
+    so an arm must never hinge on a single capture."""
+    rec, frames = {}, []
+    for attempt in range(1, tries + 1):
+        rec = _btwit_r88_run(["pw-top", "-b", "-n", str(n_arg)],
+                             bound_s, keep_chars=300, keep_raw=True)
+        frames = _btwit_r88_top_frames(rec.get("stdout_raw") or "")
+        rec["attempt"] = attempt
+        rec["frames"] = [len(f) for f in frames]
+        rec["status_sets"] = [sorted({r["status"] for r in f})
+                              for f in frames]
+        rec.pop("stdout_raw", None)
+        rec.pop("stderr_raw", None)
+        if len(frames) >= min_frames:
+            break
+    return rec, frames
+
