+def _btwit_r88_dump_objs(*args, timeout_s=20.0):
+    """`pw-dump <args>` -> (rec, parsed-list-or-None)."""
+    rec = _btwit_r88_run(["pw-dump", *[str(a) for a in args]],
+                         timeout_s, keep_chars=300)
+    try:
+        proc = subprocess.run(
+            ["pw-dump", *[str(a) for a in args]],
+            capture_output=True, timeout=timeout_s)
+        objs = json.loads(proc.stdout)
+        return rec, objs
+    except (subprocess.TimeoutExpired, OSError, ValueError):
+        return rec, None
