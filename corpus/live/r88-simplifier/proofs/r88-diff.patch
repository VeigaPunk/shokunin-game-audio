+def pwtop_r88_entry():
+    """The pw-top lattice: -n 1's all-CREATING frame is a startup
+    artifact (read the LAST frame of a multi-frame capture — the
+    printed frame count is advisory relative to N, so `-n 3` with a
+    bounded retry is the real-state witness), -n 0 is one frame,
+    -n -1/-n abc are infinite, -r bogus is the family's one loud
+    failure — and the four-witness state vocabulary agrees on our own
+    sink both idle and driven."""
+    failures, legs = [], {}
+    entry = _btwit_r88_entry_head("r88a pw-top frame lattice")
+    tools = {t: shutil.which(t) for t in
+             ("pw-top", "pw-dump", "pw-cli", "pactl", "pw-play")}
+    entry["tools"] = tools
+    if not all(tools.values()):
+        return _btwit_r88_block(
+            entry, failures,
+            f"missing tools: {[t for t, p in tools.items() if not p]}")
+    loads = {}
+    proc = None
+    try:
+        loads[BTWIT_R88_NS] = _btwit_r88_load_ns(BTWIT_R88_NS)
+        if loads[BTWIT_R88_NS].get("module_id") is None:
+            return _btwit_r88_block(
+                entry, failures,
+                f"probe null sink {BTWIT_R88_NS} never enumerated",
+                loads)
+        g0 = _pactlmon_r85_graph()
+        n0 = _pactlmon_r85_node(g0, BTWIT_R88_NS) or {}
+        own_id = str(n0.get("node_id"))
+        entry["refs"] = {"own_id": own_id,
+                         "own_serial": str(n0.get("object_serial"))}
+        # ---------- frame legs (run to exit or bound-killed) -------
+        legs["pt_n1"] = _btwit_r88_run(
+            ["pw-top", "-b", "-n", "1"], 15.0, keep_chars=400,
+            keep_raw=True)
+        legs["pt_n3"], legs_pt_n3_frames = _btwit_r88_top_until(
+            3, 2, bound_s=20.0, tries=3)
+        legs["pt_n3"]["_frames_cache"] = legs_pt_n3_frames
+        legs["pt_n0"] = _btwit_r88_run(
+            ["pw-top", "-b", "-n", "0"], 15.0, keep_chars=400,
+            keep_raw=True)
+        legs["pt_nneg"] = _btwit_r88_run(
+            ["pw-top", "-b", "-n", "-1"], BTWIT_R88_PWT_BOUND_S,
+            keep_chars=200)
+        legs["pt_nabc"] = _btwit_r88_run(
+            ["pw-top", "-b", "-n", "abc"], BTWIT_R88_PWT_BOUND_S,
+            keep_chars=200)
+        legs["pt_rbogus"] = _btwit_r88_run(
+            ["pw-top", "-r", f"r88a-bogus-{BTWIT_R88_PID}"], 15.0,
+            keep_chars=300)
+        # ---------- four-witness state agreement: idle -------------
+        sinks = _btwit_r88_sinks()
+        own_sink = next((v for v in (sinks or {}).values()
+                         if v["name"] == BTWIT_R88_NS), {})
+        g1 = _pactlmon_r85_graph()
+        n1 = _pactlmon_r85_node(g1, BTWIT_R88_NS) or {}
+        r_st = _btwit_r88_cli("info", own_id, keep_raw=True)
+        m = re.search(r'state: "([a-z]+)"',
+                      r_st.get("stdout_raw") or "")
+        r_top, t_frames = _btwit_r88_top_until(3, 2, tries=2)
+        r_top.pop("_frames_cache", None)
+        legs["pt_state_idle_toprec"] = r_top
+        own_row = next((r for r in (t_frames[-1] if t_frames else [])
+                        if r["id"] == int(own_id)), None)
+        legs["pt_state_idle"] = {
+            "top_frames": len(t_frames),
+            "pactl": own_sink.get("state"),
+            "dump": n1.get("state"),
+            "cli": m.group(1) if m else None,
+            "top": (own_row or {}).get("status"),
+            "vocab": {"pactl": _btwit_r88_state_vocab(
+                          own_sink.get("state")),
+                      "dump": _btwit_r88_state_vocab(n1.get("state")),
+                      "cli": _btwit_r88_state_vocab(
+                          m.group(1) if m else None),
+                      "top": _btwit_r88_state_vocab(
+                          (own_row or {}).get("status"))}}
+        # ---------- driven window: stream -> RUNNING ---------------
+        with tempfile.TemporaryDirectory(prefix="r88a-top-") as tmp:
+            tone = Path(tmp) / "r88a_tone.wav"
+            _playback_r78_write_tone(tone, 8.0)
+            tag = f"{BTWIT_R88_PREFIX}_pt"
+            try:
+                proc = subprocess.Popen(
+                    ["pw-play", "-P", f"node.name={tag}",
+                     "-P", f"media.role={BTWIT_R88_ROLE}",
+                     "--target", BTWIT_R88_NS, str(tone)],
+                    stdout=subprocess.DEVNULL,
+                    stderr=subprocess.PIPE,
+                    stdin=subprocess.DEVNULL,
+                    start_new_session=True)
+            except OSError as exc:
+                proc = None
+                legs["pt_state_active"] = {"spawn_error": str(exc)[:120]}
+            if proc is not None:
+                deadline = (time.monotonic() +
+                            BTWIT_R88_STREAM_WAIT_S)
+                linked = False
+                while time.monotonic() < deadline:
+                    g2 = _pactlmon_r85_graph()
+                    sn = _pactlmon_r85_node(g2, tag)
+                    edges = _pactlmon_r85_edges_out(g2, tag)
+                    if sn and sn.get("state") == "running" and any(
+                            e.get("in_node") == BTWIT_R88_NS
+                            for e in edges):
+                        linked = True
+                        break
+                    time.sleep(0.25)
+                legs["pt_state_active"] = {"linked": linked}
+                if linked:
+                    sinks2 = _btwit_r88_sinks()
+                    own_sink2 = next(
+                        (v for v in (sinks2 or {}).values()
+                         if v["name"] == BTWIT_R88_NS), {})
+                    g3 = _pactlmon_r85_graph()
+                    n3 = _pactlmon_r85_node(g3, BTWIT_R88_NS) or {}
+                    r_st2 = _btwit_r88_cli("info", own_id,
+                                           keep_raw=True)
+                    m2 = re.search(r'state: "([a-z]+)"',
+                                   r_st2.get("stdout_raw") or "")
+                    r_top2, t2 = _btwit_r88_top_until(
+                        3, 2, bound_s=20.0, tries=2)
+                    r_top2.pop("_frames_cache", None)
+                    legs["pt_state_active_toprec"] = r_top2
+                    row2 = next(
+                        (r for r in (t2[-1] if t2 else [])
+                         if r["id"] == int(own_id)), None)
+                    legs["pt_state_active"].update({
+                        "top_frames": len(t2),
+                        "pactl": own_sink2.get("state"),
+                        "dump": n3.get("state"),
+                        "cli": m2.group(1) if m2 else None,
+                        "top": (row2 or {}).get("status"),
+                        "vocab": {"pactl": _btwit_r88_state_vocab(
+                                      own_sink2.get("state")),
+                                  "dump": _btwit_r88_state_vocab(
+                                      n3.get("state")),
+                                  "cli": _btwit_r88_state_vocab(
+                                      m2.group(1) if m2 else None),
+                                  "top": _btwit_r88_state_vocab(
+                                      (row2 or {}).get("status"))}})
+    finally:
+        if proc is not None:
+            _alsapw_r84_killpg(proc, signal.SIGTERM)
+            try:
+                proc.wait(timeout=4)
+            except subprocess.TimeoutExpired:
+                _alsapw_r84_killpg(proc)
+        _btwit_r88_teardown(entry, failures, loads)
+    # ---------------- verdicts ----------------
+    for name in ("pt_n1", "pt_n0"):
+        l = legs[name]
+        frames = _btwit_r88_top_frames(l.get("stdout_raw") or "")
+        l["frames"] = [len(f) for f in frames]
+        l["status_sets"] = [sorted({r["status"] for r in f})
+                            for f in frames]
+    l = legs["pt_n1"]
+    fr = _btwit_r88_top_frames(l.get("stdout_raw") or "")
+    if len(fr) != 1 or not fr[0] or \
+            any(r["status"] != "C" for r in fr[0]):
+        failures.append(
+            f"pt_n1: frames={len(fr)} statuses="
+            f"{sorted({r['status'] for f in fr for r in f})} — the "
+            "all-CREATING first frame fails")
+    l = legs["pt_n3"]
+    fr = l.pop("_frames_cache", [])
+    if len(fr) < 2:
+        entry.setdefault("coverage_blocked", []).append(
+            f"pt_n3: {len(fr)} frames in {l.get('attempt')} tries — "
+            "the -n advisory emitted no real-state frame")
+    else:
+        if any(r["status"] != "C" for r in fr[0]):
+            failures.append(
+                "pt_n3: first frame is not all-CREATING")
+        own_row = next((r for r in fr[-1]
+                        if r["id"] == int(entry["refs"]["own_id"])),
+                       None)
+        if own_row is None:
+            failures.append(
+                "pt_n3: own sink row absent from the last frame")
+        elif own_row["status"] == "C":
+            failures.append(
+                "pt_n3: own row still CREATING in the last frame — "
+                "the real-state frame fails")
+        elif own_row["status"] not in ("S", "I", "R", "E"):
+            failures.append(
+                f"pt_n3: own row status {own_row['status']} not a "
+                "known state")
+        l["last_frame_status_hist"] = sorted(
+            {r["status"]: sum(1 for x in fr[-1]
+                             if x["status"] == r["status"])
+             for r in fr[-1]}.items())
+    l = legs["pt_n0"]
+    fr = _btwit_r88_top_frames(l.get("stdout_raw") or "")
+    if len(fr) != 1:
+        failures.append(
+            f"pt_n0: {len(fr)} frames — expected exactly one")
+    for name in ("pt_nneg", "pt_nabc"):
+        l = legs[name]
+        fr = _btwit_r88_top_frames(l.get("stdout") or "")
+        if not l.get("killed_at_bound") or not fr:
+            failures.append(
+                f"{name}: killed={l.get('killed_at_bound')} "
+                f"frames={len(fr)} — the infinite class fails")
+    l = legs["pt_rbogus"]
+    if l.get("exit_code") == 0 or \
+            l.get("error_class") != "pwtop_connect_down":
+        failures.append(
+            f"pt_rbogus: rc={l.get('exit_code')} "
+            f"class={l.get('error_class')} — the loud remote "
+            "refusal fails")
+    l = legs["pt_state_idle"]
+    if (l.get("top_frames") or 0) < 2:
+        entry.setdefault("coverage_blocked", []).append(
+            "pt_state_idle: pw-top never emitted a real-state frame "
+            f"({l.get('top_frames')} frames) — the top witness is "
+            "unmeasured")
+    else:
+        voc = l.get("vocab") or {}
+        if len({voc.get("pactl"), voc.get("dump"), voc.get("cli"),
+                voc.get("top")}) != 1 or None in voc.values():
+            failures.append(
+                f"pt_state_idle: {l} — the four-witness agreement "
+                "fails")
+    l = legs.get("pt_state_active") or {}
+    if not l.get("linked"):
+        entry.setdefault("coverage_blocked", []).append(
+            "pt_state_active: stream never linked/running — the "
+            "RUNNING-side agreement is unmeasured")
+    elif (l.get("top_frames") or 0) < 2:
+        entry.setdefault("coverage_blocked", []).append(
+            "pt_state_active: pw-top never emitted a real-state "
+            "frame under load — the top witness is unmeasured")
+    elif l.get("vocab"):
+        voc = l["vocab"]
+        if len(set(voc.values())) != 1 or \
+                voc.get("dump") != "running" or None in voc.values():
+            failures.append(
+                f"pt_state_active: {l} — the RUNNING-side "
+                "four-witness agreement fails")
+    entry["legs"] = legs
+    entry["failures"] = failures
+    return entry
