+def _btwit_r88_ls_ids(text):
+    """ids from `pw-cli ls <iface>` — `id N, type ...` rows (the
+    continuation indent is `id`-line-anchored with optional leading
+    whitespace)."""
+    return sorted(int(m.group(1)) for m in
+                  re.finditer(r"^[ \t]*id (\d+),", text or "", re.M))
+
+
+def _btwit_r88_cli_props(text):
+    """(keys, layout) of a `pw-cli info <id>` prop block — the
+    `* properties:` + `*\\t\\t` starred layout, or the flat
+    `key = "v"` ls layout (ls prefixes continuation lines with a
+    space then tabs). Both are seen on this host depending on the
+    verb, so both are parsed and the shape is recorded."""
+    star = set(re.findall(r"^\*\t\t([^\s=]+) = ", text or "", re.M))
+    flat = set(re.findall(r"^[ \t]+([^\s=]+) = ", text or "", re.M))
+    layout = "star" if re.search(r"^\*\tproperties:", text or "",
+                                 re.M) else ("flat" if flat else "none")
+    return (star | flat), layout
+
+
+def _btwit_r88_cli_params(text):
+    """Param names from the `* params:` block of `pw-cli info`."""
+    return sorted(set(re.findall(
+        r"^\*\s+\d+ \(Spa:Enum:ParamId:([A-Za-z]+)\)",
+        text or "", re.M)))
+
