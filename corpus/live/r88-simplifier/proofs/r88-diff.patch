+def _btwit_r88_bluez_objs(objs):
+    """Census objects that ARE bluez — device.api=bluez5 or an
+    api.bluez5* factory. On this host that is exactly the BLE-MIDI
+    bridge; zero Audio/* must ever appear."""
+    out = []
+    for o in objs or []:
+        p = (o.get("info") or {}).get("props") or {}
+        if str(p.get("device.api")) == "bluez5" or \
+                str(p.get("factory.name") or "").startswith("api.bluez5"):
+            out.append({"id": o.get("id"),
+                        "name": p.get("node.name"),
+                        "media_class": p.get("media.class"),
+                        "factory": p.get("factory.name")})
+    return out
