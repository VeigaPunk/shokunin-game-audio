+def _btwit_r88_sinks():
+    """`pactl list sinks short` -> {index: {"name":, "state":}}."""
+    try:
+        proc = subprocess.run(["pactl", "list", "sinks", "short"],
+                              capture_output=True, timeout=10)
+    except (subprocess.TimeoutExpired, OSError):
+        return None
+    out = {}
+    for ln in proc.stdout.decode(errors="replace").splitlines():
+        f = ln.split("\t")
+        if len(f) >= 2 and f[0].strip().isdigit():
+            out[int(f[0].strip())] = {
+                "name": f[1].strip(),
+                "state": (f[-1].strip() if len(f) >= 3 else "")}
+    return out
+
