+def _btwit_r88_pred(objs, key):
+    """The set-rule predictor: ids of census objects whose object.id
+    or props.object.serial equals `key`."""
+    out = set()
+    for o in objs or []:
+        p = (o.get("info") or {}).get("props") or {}
+        if str(o.get("id")) == str(key) or \
+                str(p.get("object.serial")) == str(key):
+            out.add(str(o.get("id")))
+    return out
+
+
+def _btwit_r88_setrule_leg(name, key, census):
+    """pw-dump <key> vs the predicted {id==K} ∪ {serial==K} set;
+    on mismatch re-census once (mid-leg churn), then judge."""
+    rec, objs = _btwit_r88_dump_objs(key)
+    got = (sorted(str(o.get("id")) for o in objs)
+           if objs is not None else None)
+    pred = sorted(_btwit_r88_pred(census, key))
+    churn = False
+    if got is not None and got != pred:
+        c2 = _btwit_r88_objs()
+        pred2 = sorted(_btwit_r88_pred(c2, key))
+        if pred2 != pred:
+            churn = True
+            pred = pred2
+    return {"key": str(key), "got": got, "predicted": pred,
+            "churn_recensus": churn, "argv": rec.get("argv"),
+            "exit_code": rec.get("exit_code"),
+            "stderr": rec.get("stderr")}
+
