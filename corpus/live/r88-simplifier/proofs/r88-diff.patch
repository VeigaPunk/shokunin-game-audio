+def _btwit_r88_pactl_list_lines(pattern):
+    """`pactl list` lines matching `pattern` (case-insensitive) —
+    a dedicated grep reader: the full listing is ~50 KB, far past any
+    keep_chars bound, so the match is computed on the raw stream."""
+    try:
+        proc = subprocess.run(["pactl", "list"], capture_output=True,
+                              timeout=15)
+    except (subprocess.TimeoutExpired, OSError):
+        return None
+    return [ln.strip() for ln in
+            proc.stdout.decode(errors="replace").splitlines()
+            if re.search(pattern, ln, re.I)]
