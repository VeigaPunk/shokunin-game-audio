+def _btwit_r88_errclass(text):
+    for name, pat in _BTWIT_R88_ERR_CLASSES:
+        m = re.search(pat, text or "")
+        if m:
+            return name, m.group(0).strip()
+    return _pwbind_r87_errclass(text or "")
