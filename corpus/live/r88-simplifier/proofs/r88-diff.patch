+def _btwit_r88_card_active(card_name):
+    """`pactl list cards` -> the Active Profile of `card_name`."""
+    try:
+        proc = subprocess.run(["pactl", "list", "cards"],
+                              capture_output=True, timeout=10)
+    except (subprocess.TimeoutExpired, OSError):
+        return None
+    cur, found = None, None
+    for ln in proc.stdout.decode(errors="replace").splitlines():
+        m = re.match(r"^\s+Name:\s+(\S+)", ln)
+        if m:
+            cur = m.group(1)
+        m2 = re.match(r"^\s+Active Profile:\s+(\S+)", ln)
+        if m2 and cur == card_name:
+            found = m2.group(1)
+    return found
