+def _btwit_r88_strings_hits(path, needle):
+    """`strings -a <path>` -> {substring_hits, standalone_lines} for
+    `needle` — the .so is ~1 MB of strings, so hits are filtered
+    in-process rather than trusted to a truncated capture."""
+    try:
+        proc = subprocess.run(["strings", "-a", path],
+                              capture_output=True, timeout=60)
+    except (subprocess.TimeoutExpired, OSError):
+        return None
+    lines = proc.stdout.decode(errors="replace").splitlines()
+    return {"substring_hits": sorted(
+                {ln.strip() for ln in lines if needle in ln}),
+            "standalone_lines": sum(
+                1 for ln in lines if ln.strip() == needle),
+            "bluez5_names": sum(
+                1 for ln in set(lines) if "bluez5." in ln)}
