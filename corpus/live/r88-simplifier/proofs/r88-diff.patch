+def _btwit_r88_load_ns(name):
+    """Load + gate one null sink (r83 loader); carries field/value for
+    the name-verified unload."""
+    leaf = _pwcat_r83_ns_load(name)
+    leaf["field"] = "sink_name"
+    leaf["value"] = name
+    return leaf
