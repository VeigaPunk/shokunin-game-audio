+def _btwit_r88_state_vocab(state):
+    """Map one witness's state token to the shared vocabulary."""
+    return {"SUSPENDED": "suspended", "IDLE": "idle",
+            "RUNNING": "running", "CORKED": "corked",
+            "S": "suspended", "I": "idle", "R": "running",
+            "E": "error", "C": "creating",
+            "suspended": "suspended", "idle": "idle",
+            "running": "running", "error": "error"}.get(
+                str(state), str(state))
+
