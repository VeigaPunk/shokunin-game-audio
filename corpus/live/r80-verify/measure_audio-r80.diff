+                legs["t2_pwlink_lingers"]["teardown_d"] = {
+                    "exit_code": proc.returncode}
+            except (subprocess.TimeoutExpired, OSError) as exc:
+                legs["t2_pwlink_lingers"]["teardown_d"] = {
+                    "exit_code": None, "error": str(exc)[:120]}
+            # t3: `pw-link -m` — the link is the CLIENT's; it dies with
+            # the process.
