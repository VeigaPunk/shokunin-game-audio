+            si = _module_r80_sink_input(tag)
+            edges_before = _module_r80_edges(tag)
+            move = _module_r80_pactl(
+                ["move-sink-input", str(si.get("index")),
+                 names["mv_b"]]) if si.get("index") is not None else \
